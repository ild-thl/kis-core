# The admin account, its user name is the part before the @ and you log in with it.
ADMIN_EMAIL=admin@th-luebeck.de
# Change it, a real installation refuses to start while this is the example value.
ADMIN_PASSWORD=adminpw

# Encrypts the stored provider API keys, set a long random string once and never change it.
KIS_SECRETS_KEY=change-me-to-a-random-string

# Every other setting has a default, the README lists them.
