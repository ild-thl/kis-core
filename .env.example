# No login, you are admin, email and password below not needed. Local only.
# AUTH_DISABLED=true

# Admin login, user name is the part before the @.
ADMIN_EMAIL=admin@example.org
# Change it, production refuses this value.
ADMIN_PASSWORD=adminpw
# Other login name than the part of ADMIN_EMAIL before the @.
# ADMIN_USERNAME=admin

# Server only. true: askFrancis runs Caddy with automatic HTTPS for DOMAIN.
# false: your own proxy forwards to 127.0.0.1:3000.
# AUTO_HTTPS=false
# DOMAIN=askfrancis.example.org

# Modules this installation runs, needs a restart, locally the workers of both start anyway.
# MODULES=aia,tools
